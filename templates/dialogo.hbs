<section class="ajuste-nd">
  <div class="ajuste-nd__campos">
    <label>{{localize "T20AJND.NDAlvo"}}
      <select name="nd">
        {{#each nds}}<option value="{{valor}}" {{#if selecionado}}selected{{/if}}>{{valor}}</option>{{/each}}
      </select>
    </label>
    <label>{{localize "T20AJND.Papel"}}
      <select name="papel">
        {{#each papeis}}<option value="{{valor}}" {{#if selecionado}}selected{{/if}}>{{rotulo}}</option>{{/each}}
      </select>
    </label>
    <label class="ajuste-nd__copia">
      <input type="checkbox" name="copiar" {{#if copiar}}checked{{/if}}>
      {{localize "T20AJND.Copia"}}
    </label>
  </div>
  <div class="ajuste-nd__campos">
    <label class="ajuste-nd__copia">
      <input type="checkbox" name="manterProporcao" {{#if manterProporcao}}checked{{/if}}>
      {{localize "T20AJND.ManterProporcao"}}
    </label>
    <label class="ajuste-nd__copia">
      <input type="checkbox" name="atualizarCDs" {{#if atualizarCDs}}checked{{/if}}>
      {{localize "T20AJND.AtualizarCDs"}}
    </label>
    <label class="ajuste-nd__copia">
      <input type="checkbox" name="atualizarNivelConjurador" {{#if atualizarNivelConjurador}}checked{{/if}}>
      {{localize "T20AJND.AtualizarNivelConjurador"}}
    </label>
    <label class="ajuste-nd__copia">
      <input type="checkbox" name="atualizarTextoAtaques" {{#if atualizarTextoAtaques}}checked{{/if}}>
      {{localize "T20AJND.AtualizarAtaques"}}
    </label>
  </div>

  <div class="ajuste-nd__campos">
    <label class="ajuste-nd__copia">
      <input type="checkbox" name="chefeFinal" {{#if chefeFinal}}checked{{/if}}>
      {{localize "T20AJND.ChefeFinal"}}
    </label>
    <label class="ajuste-nd__copia">
      <input type="checkbox" name="enxame" {{#if enxame}}checked{{/if}}>
      {{localize "T20AJND.Enxame"}}
    </label>
    <label class="ajuste-nd__copia">
      <input type="checkbox" name="bando" {{#if bando}}checked{{/if}}>
      {{localize "T20AJND.Bando"}}
    </label>
    <label>{{localize "T20AJND.BandoEscala"}}
      <select name="bandoEscala" {{#unless bando}}disabled{{/unless}}>
        {{#each escalas}}<option value="{{valor}}" {{#if selecionado}}selected{{/if}}>{{valor}}</option>{{/each}}
      </select>
    </label>
    <label>{{localize "T20AJND.BandoAumento"}}
      <input type="number" name="bandoAumento" min="0" max="12" value="{{bandoAumento}}" {{#unless bando}}disabled{{/unless}}>
    </label>
  </div>

  <fieldset>
    <legend>{{localize "T20AJND.Resistencias"}}</legend>
    <div class="ajuste-nd__campos">
      {{#each ordem}}
      <label>{{rotulo}}
        <select name="ordem-{{indice}}">
          {{#each opcoes}}<option value="{{valor}}" {{#if selecionado}}selected{{/if}}>{{nome}}</option>{{/each}}
        </select>
      </label>
      {{/each}}
    </div>
  </fieldset>

  {{#if erro}}
  <p class="ajuste-nd__erro">{{erro}}</p>
  {{else}}
  <table class="ajuste-nd__tabela">
    <thead><tr><th>{{localize "T20AJND.Estatistica"}}</th><th>{{localize "T20AJND.Antes"}}</th><th>{{localize "T20AJND.Depois"}}</th></tr></thead>
    <tbody>
      {{#each linhas}}
      <tr class="{{#if mudou}}mudou{{/if}}"><td>{{rotulo}}</td><td>{{antes}}</td><td>{{depois}}</td></tr>
      {{/each}}
    </tbody>
  </table>

  <fieldset>
    <legend>
      {{localize "T20AJND.Armas"}} ({{localize "T20AJND.DanoAlvo"}}: {{danoAlvo}} {{localize "T20AJND.PorRodada"}})
      {{#if selo}}<span class="ajuste-nd__selo selo-{{selo.alerta}}">{{selo.texto}}</span>{{/if}}
    </legend>
    <table class="ajuste-nd__tabela">
      <thead>
        <tr>
          <th>{{localize "T20AJND.Arma"}}</th>
          <th>{{localize "T20AJND.Ataques"}}</th>
          <th title="{{localize 'T20AJND.AlternativaDica'}}">{{localize "T20AJND.Alternativa"}}</th>
          <th>{{localize "T20AJND.Antes"}}</th>
          <th>{{localize "T20AJND.Depois"}}</th>
        </tr>
      </thead>
      <tbody>
        {{#each armas}}
        <tr>
          <td>{{nome}}</td>
          <td><input type="number" min="0" max="9" value="{{ataques}}" data-ataques="{{id}}" {{#if ../enxame}}disabled{{/if}}></td>
          <td><input type="checkbox" data-alternativa="{{id}}" {{#if alternativa}}checked{{/if}}></td>
          <td>{{antes}}</td>
          <td>{{#if removida}}<em>{{localize "T20AJND.ArmaRemovida"}}</em>{{else if depois}}{{depois}} <small>(≈ {{mediaDepois}})</small>{{else}}<em>{{localize "T20AJND.SemAlteracao"}}</em>{{/if}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{#if rodada}}
    <p class="ajuste-nd__rodada">{{localize "T20AJND.TotalRodada"}}: <strong>{{rodada.obtido}}</strong> {{localize "T20AJND.De"}} {{rodada.alvo}} ({{rodada.ataques}} {{localize "T20AJND.AtaquesTotal"}})</p>
    {{/if}}
  </fieldset>

  {{#if textos.temAlgo}}
  <div class="ajuste-nd__textos">
    <strong>{{localize "T20AJND.TextosAlterados"}}</strong>
    <ul>
      {{#each textos.cds}}<li>{{this}}</li>{{/each}}
      {{#each textos.conjurador}}<li>{{this}}</li>{{/each}}
      {{#each textos.ataques}}<li>{{rotulo}}: {{antes}} → <em>{{depois}}</em></li>{{/each}}
    </ul>
  </div>
  {{/if}}

  {{#if avisos.length}}
  <div class="ajuste-nd__avisos">
    <strong>{{localize "T20AJND.Avisos"}}</strong>
    <ul>{{#each avisos}}<li>{{this}}</li>{{/each}}</ul>
  </div>
  {{/if}}

  {{#if notasTemplates.length}}
  <div class="ajuste-nd__templates">
    <strong>{{localize "T20AJND.Templates"}}</strong>
    <ul>{{#each notasTemplates}}<li>{{this}}</li>{{/each}}</ul>
  </div>
  {{/if}}

  {{#if patamar.length}}
  <div class="ajuste-nd__patamar">
    <strong>{{localize "T20AJND.Patamar"}}</strong>
    <ul>{{#each patamar}}<li>{{this}}</li>{{/each}}</ul>
  </div>
  {{/if}}

  {{#if sugestoes.length}}
  <div class="ajuste-nd__sugestoes">
    <strong>{{localize "T20AJND.Sugestoes"}}</strong>
    <ul>{{#each sugestoes}}<li>{{this}}</li>{{/each}}</ul>
  </div>
  {{/if}}

  {{#if revisar.length}}
  <div class="ajuste-nd__revisar">
    <strong>{{localize "T20AJND.Revisar"}}</strong>
    <ul>{{#each revisar}}<li>{{this}}</li>{{/each}}</ul>
  </div>
  {{/if}}
  {{/if}}

  <footer class="ajuste-nd__rodape">
    <button type="button" data-action="aplicar" {{#if erro}}disabled{{/if}}><i class="fas fa-check"></i> {{localize "T20AJND.AplicarBotao"}}</button>
    <button type="button" data-action="cancelar"><i class="fas fa-times"></i> {{localize "T20AJND.Cancelar"}}</button>
  </footer>
</section>
